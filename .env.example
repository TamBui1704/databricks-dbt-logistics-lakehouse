# Databricks Connection Credentials for dbt
# Copy this file to .env and replace with your actual Databricks workspace details

# 1. Server Hostname (without https://)
DATABRICKS_HOST=community.cloud.databricks.com

# 2. HTTP Path (Get from Databricks Cluster -> Advanced Options -> JDBC/ODBC)
DATABRICKS_HTTP_PATH=sql/protocolv1/o/0/xxxx-xxxxxx-xxxxxx

# 3. Personal Access Token (Get from Databricks User Settings -> Developer -> Access Tokens)
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
